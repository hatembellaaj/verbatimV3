# ─── Configuration DORIA Profiler ──────────────────────────────────────────
# Copier ce fichier en `.env` (à la racine, à côté de docker-compose.yml)
# pour le profil prod, ou en `.env.local` pour le profil dev.

# ─── Côté serveur (profil prod) ────────────────────────────────────────────
# Clé Anthropic — lue par le proxy Node, JAMAIS exposée au navigateur.
# Obligatoire pour le profil prod (sinon /api/messages renvoie 500).
ANTHROPIC_API_KEY=

# Port public du frontend (défaut 8080). L'app sera accessible sur :
#   http://<IP_SERVEUR>:${WEB_PORT}/
WEB_PORT=8080

# ─── Côté frontend (build Vite) ────────────────────────────────────────────
# Surcharge le modèle par défaut (claude-sonnet-4-6).
# Modèles valides à fin avril 2026 :
#   claude-sonnet-4-6        (équilibré, recommandé)
#   claude-opus-4-6          (le plus puissant, plus cher)
#   claude-haiku-4-5-20251001 (rapide et économique)
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Active le mode mock (réponses simulées, sans appel API). Utile pour dev offline.
# VITE_USE_MOCK=false
