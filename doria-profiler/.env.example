# Optionnel — laisser vide pour rester en mode démo / IA simulée.
# Pour activer l'analyse par Claude, renommer en .env.local et renseigner la clé.
VITE_ANTHROPIC_API_KEY=

# Optionnel — surcharge le modèle par défaut (claude-sonnet-4-6).
# Modèles valides à fin avril 2026 :
#   claude-sonnet-4-6        (équilibré, recommandé)
#   claude-opus-4-6          (le plus puissant, plus cher)
#   claude-haiku-4-5-20251001 (rapide et économique)
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-6
